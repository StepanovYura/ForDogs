# ─────────────────────────── База данных ───────────────────────────
# ONREZA → раздел Managed PostgreSQL → готовые примеры подключения.
# Скопируйте строки из панели целиком, ничего не дописывая руками.
#
# DATABASE_URL — режим Pooled (через PgBouncer). Через него идут все
# запросы сайта.
DATABASE_URL="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ-pooler.kaiki.onreza.ru:5432/БАЗА?sslmode=require&connection_limit=10&pgbouncer=true"

# DIRECT_URL — режим Direct (тот же адрес, но без -pooler и без параметров
# pgbouncer/connection_limit). Нужен Prisma для db:push, migrate и seed:
# через PgBouncer в transaction-режиме они не отрабатывают.
DIRECT_URL="postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ.kaiki.onreza.ru:5432/БАЗА?sslmode=require"

# ─────────────────────────── Авторизация ───────────────────────────
# Секрет для подписи сессионных токенов. Сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="замените-на-случайную-строку-минимум-32-символа"

# Логин и пароль администратора, который создаётся при `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@nixdog.ru"
SEED_ADMIN_PASSWORD="admin12345"

# ──────────────────── Оплата: карта и СБП ─────────────────────
# Какой банк принимает оплату. Адаптер банка лежит в lib/payments/<имя>.js.
#   tbank — Т-Банк, интернет-эквайринг: карта + СБП (основной)
#   sber  — Сбер (запасной вариант)
#   mock  — эмулятор банка для разработки: оплата ведёт на страницу
#           /dev/bank/..., где платёж можно «оплатить» или «отклонить».
# Локально по умолчанию mock, на проде переменную нужно задать обязательно.
PAYMENT_PROVIDER="mock"

# Сколько минут ждём оплату (QR-код и ссылка на страницу банка). Пока он жив, товары зарезервированы
# за покупателем; после — заказ отменяется, остатки возвращаются на склад.
SBP_QR_TTL_MINUTES="15"

# Оплата картой на платёжной странице банка. 0 — выключить (останется
# только СБП), например пока банк не подключил приём карт.
# PAYMENT_CARD_ENABLED="1"

# «Долями» (оплата частями от Т-Банка): 1 — показывать способ. Включать
# после того, как банк подключит «Долями» к терминалу.
# PAYMENT_DOLYAME_ENABLED="0"
# Пределы суммы заказа для «Долями», в рублях, — как в договоре с банком.
# Вне их способ не предлагается. Пусто — без ограничений.
# DOLYAME_MIN_RUB=""
# DOLYAME_MAX_RUB=""

# В боевой сборке эмулятор выключен. Включить его на тестовом стенде,
# чтобы показать оплату заказчику (на боевом сайте — нельзя!):
# SBP_MOCK_IN_PRODUCTION="1"

# ─── Т-Банк (PAYMENT_PROVIDER="tbank") ───
# Личный кабинет Т-Бизнеса → Интернет-эквайринг → Магазины → Терминалы.
# Сначала — тестовый терминал (ключ оканчивается на DEMO), потом боевой.
# TBANK_TERMINAL_KEY=""
# TBANK_PASSWORD=""
# Адрес API. Для тестового терминала Т-Банк может дать отдельный адрес —
# тогда укажите его здесь.
# TBANK_API_URL="https://securepay.tinkoff.ru/v2"
# Префикс номера заказа в банке — на тестовом терминале, если база
# сбрасывалась и номера заказов начали повторяться.
# TBANK_ORDER_PREFIX=""
# Чеки (54-ФЗ): 1 — передавать чек в каждом платеже. Включать после того,
# как к терминалу в кабинете Т-Бизнеса подключена онлайн-касса.
# TBANK_RECEIPTS="0"
# Система налогообложения: osn, usn_income, usn_income_outcome, esn, patent.
# TBANK_TAXATION="usn_income"
# Ставка НДС в чеке: none, vat0, vat5, vat7, vat10, vat20 — уточните у бухгалтера.
# TBANK_VAT="none"
# Версия формата фискальных документов кассы: 1.05 или 1.2.
# TBANK_FFD_VERSION="1.05"

# ─── Сбер (PAYMENT_PROVIDER="sber") ───
# Логин и пароль API-пользователя (обычно вида xxx-api) из личного кабинета
# Сбера — или вместо них токен SBER_TOKEN.
# SBER_USERNAME=""
# SBER_PASSWORD=""
# SBER_TOKEN=""
# Адрес шлюза. По умолчанию тестовый стенд; для боевых платежей:
#   https://securepayments.sberbank.ru/payment/rest
# SBER_API_URL="https://3dsec.sberbank.ru/payment/rest"
# Секрет для проверки подписи уведомлений (callback) — из кабинета Сбера.
# SBER_CALLBACK_SECRET=""
# 1 — передавать адрес уведомлений с каждым заказом (опция «динамический
# callback» у Сбера), 0 — адрес прописан в кабинете.
# SBER_DYNAMIC_CALLBACK="1"
# Префикс номера заказа в шлюзе — нужен на тестовом стенде, если база
# сбрасывалась и номера заказов начали повторяться.
# SBER_ORDER_PREFIX=""
# Чеки через облачную кассу, подключённую к Сберу: 1 — передавать корзину.
# SBER_FISCALIZATION="0"
# Система налогообложения: 0 — ОСН, 1 — УСН доходы, 2 — УСН доходы минус
# расходы, 5 — ЕСХН, 6 — патент. Уточните у бухгалтера.
# SBER_TAX_SYSTEM="1"
# Ставка НДС в чеке: 0 — без НДС. Уточните у бухгалтера.
# SBER_TAX_TYPE="0"
# Единица измерения в чеке: «шт» для ФФД 1.05, «0» для ФФД 1.2.
# SBER_MEASURE="шт"

# ──────────────────────── Письма о заказах ─────────────────────────
# SMTP почтового сервиса: Яндекс 360, Mail.ru для бизнеса, Unisender,
# SendPulse… Пока не заполнено, письма сохраняются файлами в папку
# .outbox (только при локальной разработке).
# Пример для Яндекс 360: SMTP_HOST="smtp.yandex.ru", SMTP_PORT="465",
# SMTP_USER — адрес ящика, SMTP_PASSWORD — пароль приложения из
# настроек безопасности Яндекс ID (не обычный пароль от почты).
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASSWORD=""
# От кого письма: «Имя <адрес>», адрес должен совпадать с SMTP_USER.
# MAIL_FROM="NIXDOG STUDIO <shop@nixdog.ru>"
# Куда слать уведомления о новых оплаченных заказах.
# ADMIN_EMAIL="owner@nixdog.ru"

# ──────────────── Yandex Object Storage (картинки) ─────────────────
# Консоль Yandex Cloud → Object Storage → бакет + сервисный аккаунт
# со статическим ключом доступа.
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="nixdog-media"
S3_ACCESS_KEY_ID="YCAJExxxxxxxxxxxxxxxxxx"
S3_SECRET_ACCESS_KEY="YCxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Необязательно: свой домен или CDN перед бакетом.
# S3_PUBLIC_URL="https://media.nixdog.ru"

# ────────────────────────── Адрес сайта ────────────────────────────
# Без слэша на конце. Из него собирается адрес вебхука для банка.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
